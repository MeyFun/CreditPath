                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/client/applications/{{clientApplicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "client",
                "applications",
                "{{clientApplicationId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 3000000,\n  \"term_months\": 24\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Черновик обновлён', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Отправить заявку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"signer_position\": \"ceo\", \"authority_confirmed\": true, \"consent_bki\": true, \"consent_personal_data\": true}"
            },
            "url": {
              "raw": "{{baseUrl}}/client/applications/{{clientApplicationId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "client",
                "applications",
                "{{clientApplicationId}}",
                "submit"
              ]
            }
          }
        },
        {
          "name": "Статус заявки",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/client/applications/{{clientApplicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "client",
                "applications",
                "{{clientApplicationId}}"
              ]
            }
          }
        },
        {
          "name": "Удалить черновик (204; отправленную заявку удалить нельзя — 409)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/client/applications/{{draftApplicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "client",
                "applications",
                "{{draftApplicationId}}"
              ]
            }
          }
        },
        {
          "name": "Загрузить доверенность (МЧД) для чужой компании",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/client/applications/{{clientApplicationId}}/documents?purpose=power_of_attorney",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "client",
                "applications",
                "{{clientApplicationId}}",
                "documents"
              ],
              "query": [
                {
                  "key": "purpose",
                  "value": "power_of_attorney"
                }
              ]
            }
          }
        },
        {
          "name": "Дашборд клиента",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/client/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "client",
                "dashboard"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Дашборд', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Мои заявки (в работе)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/client/applications?status_group=active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "client",
                "applications"
              ],
              "query": [
                {
                  "key": "status_group",
                  "value": "active"
                }
              ]
            }
          }
        },
        {
          "name": "Профиль компании",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/client/company",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "client",
                "company"
              ]
            }
          }
        },
        {
          "name": "Ответ на запрос уточнений (409, если заявка не в NEED_INFO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/client/applications/{{clientApplicationId}}/respond",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "client",
                "applications",
                "{{clientApplicationId}}",
                "respond"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Выручка и прибыль за прошлый год\",\n  \"declared_revenue\": 6000000,\n  \"declared_profit\": 800000\n}"
            }
          }
        },
        {
          "name": "Повторная подача отклонённой (409, если заявка не отклонена)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/client/applications/{{clientApplicationId}}/resubmit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "client",
                "applications",
                "{{clientApplicationId}}",
                "resubmit"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "04 · Рабочее место сотрудника",
      "item": [
        {
          "name": "Статистика сотрудника",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employee/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employee",
                "stats"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статистика', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Мои назначенные заявки",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employee/applications?scope=queue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employee",
                "applications"
              ],
              "query": [
                {
                  "key": "scope",
                  "value": "queue"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const list = pm.response.json();",
                  "// Берём заявку клиента из папки 03, если она назначена этому сотруднику.",
                  "const mine = Array.isArray(list) ? list.find((a) => String(a.id) === String(pm.collectionVariables.get('clientApplicationId'))) : null;",
                  "if (mine || (Array.isArray(list) && list.length)) { pm.collectionVariables.set('employeeApplicationId', (mine || list[0]).id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Карточка заявки",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employee/applications/{{employeeApplicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employee",
                "applications",
                "{{employeeApplicationId}}"
              ]
            }
          }
        },
        {
          "name": "Одобрить заявку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\",\n  \"comment\": \"Проверено в Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employee/applications/{{employeeApplicationId}}/decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employee",
                "applications",
                "{{employeeApplicationId}}",
                "decision"
              ]
            }
          }
        },
        {
          "name": "Клиентский кабинет сотрудника",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/client/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "client",
                "dashboard"
              ]
            }
          }
        }
      ]
    },
