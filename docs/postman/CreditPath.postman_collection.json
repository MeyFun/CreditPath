{
  "info": {
    "name": "CreditPath API",
    "description": "Демонстрационная коллекция полного сценария CreditPath: вход, проверка ИНН, заявка, мок-проверки, решение сотрудника, аудит. Пароль демо-пользователей — DemoPass123!. Папки идут по порядку сквозного сценария; описание ручек — docs/api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "clientToken",
      "value": ""
    },
    {
      "key": "employeeToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "clientApplicationId",
      "value": ""
    },
    {
      "key": "employeeApplicationId",
      "value": ""
    },
    {
      "key": "draftApplicationId",
      "value": ""
    },
    {
      "key": "scoringConfig",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 · Авторизация",
      "item": [
        {
          "name": "Вход клиента",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{clientUsername}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Вход выполнен', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('clientToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Вход сотрудника",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"employee1\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Вход сотрудника выполнен', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('employeeToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Вход администратора",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Вход администратора выполнен', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 · Публичный каталог и реестр",
      "item": [
        {
          "name": "Каталог продуктов",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/public/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "products"
              ]
            }
          }
        },
        {
          "name": "Проверка ИНН в реестре",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/public/registry/9900000017",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "registry",
                "9900000017"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ]
          }
        },
        {
          "name": "Несуществующий ИНН (404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/public/registry/9900000088",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "registry",
                "9900000088"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ]
          }
        },
        {
          "name": "Расчёт платежа (калькулятор)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/payment-schedule?amount=3000000&rate=14.5&term_months=24",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "payment-schedule"
              ],
              "query": [
                {
                  "key": "amount",
                  "value": "3000000"
                },
                {
                  "key": "rate",
                  "value": "14.5"
                },
                {
                  "key": "term_months",
                  "value": "24"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Платёж рассчитан', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Проверка ИНН без входа (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/registry/9900000017",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "registry",
                "9900000017"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Нужен вход', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 · Клиентская заявка",
      "item": [
        {
          "name": "Создать черновик",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"amount\": 3000000,\n  \"term_months\": 24,\n  \"purpose\": \"working_capital\",\n  \"company_inn\": \"9900000017\",\n  \"company_name\": \"ООО «Северный Ветер»\",\n  \"collateral\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/client/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "client",
                "applications"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Черновик создан', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('clientApplicationId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Изменить черновик",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
