                "products"
              ]
            }
          }
        },
        {
          "name": "Создать продукт с целями",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"LEASING\",\n  \"name\": \"Лизинг техники\",\n  \"short_description\": \"Техника в лизинг\",\n  \"min_amount\": 500000,\n  \"max_amount\": 5000000,\n  \"min_term_months\": 6,\n  \"max_term_months\": 48,\n  \"rate\": 15.5,\n  \"purposes\": [\n    {\n      \"code\": \"trucks\",\n      \"label\": \"Грузовой транспорт\"\n    },\n    {\n      \"code\": \"tools\",\n      \"label\": \"Станки\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "products"
              ]
            }
          }
        },
        {
          "name": "Изменить цели продукта (409, если по цели есть незавершённые заявки)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
