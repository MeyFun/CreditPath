# Скопируйте в .env и при необходимости измените значения.
# Все значения имеют безопасные демонстрационные значения по умолчанию в docker-compose.yml.

# Порты на хосте
FRONTEND_PORT=8080
BACKEND_PORT=8000

# PostgreSQL
POSTGRES_HOST_PORT=55432
POSTGRES_DB=creditpath
POSTGRES_USER=creditpath
POSTGRES_PASSWORD=creditpath_demo
DATABASE_URL=postgresql+psycopg://creditpath:creditpath_demo@db:5432/creditpath

# Безопасность
# Пусто — backend сгенерирует случайный секрет при старте. Для production задайте свой.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
LOGIN_RATE_LIMIT=5
LOGIN_USER_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=300
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DEMO_PASSWORD=DemoPass123!

# Внешние моки (внутренняя сеть Docker)
REGISTRY_URL=http://registry-mock:8000
BKI_URL=http://bki-mock:8000
EXTERNAL_TIMEOUT_SECONDS=4
EXTERNAL_RETRIES=2

# Файлы
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
SEED_DEMO=true
LOG_LEVEL=INFO
RESUME_PIPELINES=true
